<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ispw</groupId>
    <artifactId>uniride</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.5</javafx.version>
        <junit.version>5.9.2</junit.version>

        <!-- Coordinate del progetto su sonarcloud.io (repository collegato). -->
        <sonar.projectKey>AlessioCarta_ISPW</sonar.projectKey>
        <sonar.organization>alessiocarta</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        <!-- La regola S106 (System.out/System.err al posto di un logger) è tollerata solo al
             confine CLI: è lì che l'applicazione deve necessariamente stampare a console per
             interagire con l'utente in assenza di una GUI. Ovunque altrove il logging passa
             dal LoggerCustom centralizzato (vedi sezione 5/7 della documentazione tecnica). -->
        <sonar.issue.ignore.multicriteria>cli1,cli2</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.cli1.ruleKey>java:S106</sonar.issue.ignore.multicriteria.cli1.ruleKey>
        <sonar.issue.ignore.multicriteria.cli1.resourceKey>**/boundary/*CLI.java</sonar.issue.ignore.multicriteria.cli1.resourceKey>
        <sonar.issue.ignore.multicriteria.cli2.ruleKey>java:S106</sonar.issue.ignore.multicriteria.cli2.ruleKey>
        <sonar.issue.ignore.multicriteria.cli2.resourceKey>**/CliMain.java</sonar.issue.ignore.multicriteria.cli2.resourceKey>
    </properties>

    <dependencies>
        <!-- JavaFX Dependencies -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JUnit 5 Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <!-- Exec Plugin to run JavaFX / CLI -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- Default execution (GUI) -->
                    <mainClass>com.ispw.uniride.Launcher</mainClass>
                </configuration>
            </plugin>
            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.ispw.uniride.Launcher</mainClass>
                </configuration>
            </plugin>
            <!-- JaCoCo: genera il report di code coverage letto da SonarCloud (soglia minima 60%) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Sonar Maven Plugin: esegue l'analisi statica e la invia a SonarCloud (mvn sonar:sonar) -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>3.11.0.3922</version>
            </plugin>
        </plugins>
    </build>

</project>
