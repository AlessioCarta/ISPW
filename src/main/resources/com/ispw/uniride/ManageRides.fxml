<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.uniride.boundary.ManageRidesBoundary" stylesheets="@style.css" styleClass="app-background">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="dashboard-header">
            <Button text="⭠  Indietro" onAction="#handleBack" styleClass="back-button" />
            <Label text="Le Mie Corse" styleClass="dashboard-title" />
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0">
            <padding><Insets top="24" right="30" bottom="30" left="30"/></padding>
            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="🚙  Corse Offerte (Guidatore)">
                        <content>
                            <VBox spacing="12">
                                <padding><Insets top="14" right="10" bottom="10" left="10"/></padding>
                                <ListView fx:id="offeredList" VBox.vgrow="ALWAYS" prefHeight="150" />
                                <HBox spacing="12">
                                    <Button text="Completa Corsa" onAction="#handleCompleteRide" styleClass="action-button" />
                                    <Button text="Annulla Corsa" onAction="#handleCancelOfferedRide" styleClass="danger-button" />
                                </HBox>
                                <Label text="Richieste di prenotazione in sospeso per la corsa selezionata" styleClass="form-label" />
                                <ListView fx:id="pendingRequestsList" VBox.vgrow="ALWAYS" prefHeight="130" />
                                <HBox spacing="12">
                                    <Button text="Conferma Richiesta" onAction="#handleConfirmRequest" styleClass="action-button" />
                                    <Button text="Rifiuta Richiesta" onAction="#handleRejectRequest" styleClass="danger-button" />
                                </HBox>
                            </VBox>
                        </content>
                    </Tab>
                    <Tab text="🎟  Prenotazioni (Passeggero)">
                        <content>
                            <VBox spacing="14">
                                <padding><Insets top="14" right="10" bottom="10" left="10"/></padding>
                                <ListView fx:id="bookedList" VBox.vgrow="ALWAYS" />
                                <Button text="Annulla Prenotazione" onAction="#handleCancelBooking" styleClass="danger-button" />
                            </VBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
            <Label fx:id="messageLabel" styleClass="message-label" wrapText="true" alignment="CENTER" maxWidth="Infinity" />
        </VBox>
    </center>
</BorderPane>
