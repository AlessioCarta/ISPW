<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.uniride.boundary.StudentDashboardBoundary" stylesheets="@style.css" styleClass="app-background">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="dashboard-header">
            <Label text="🚗 UniRide" styleClass="dashboard-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="36.0">
            <padding><Insets top="60" right="50" bottom="50" left="50"/></padding>
            <Label fx:id="welcomeLabel" styleClass="welcome-label" />

            <HBox spacing="24" alignment="CENTER">
                <Button text="🚙  Offri Passaggio" styleClass="action-button" onAction="#handleOfferRide" />
                <Button text="🔎  Cerca Passaggio" styleClass="action-button" onAction="#handleSearchRide" />
                <Button text="📋  Le Mie Corse" styleClass="action-button" onAction="#handleMyRides" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
