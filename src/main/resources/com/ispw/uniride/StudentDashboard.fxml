<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.uniride.boundary.StudentDashboardBoundary" stylesheets="@style.css">
    <top>
        <HBox spacing="20" styleClass="dashboard-header">
            <Label text="UniRide Dashboard" styleClass="dashboard-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#handleLogout" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="30.0">
            <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>
            <Label fx:id="welcomeLabel" styleClass="welcome-label" />

            <HBox spacing="40" alignment="CENTER">
                <Button text="Offri Passaggio" styleClass="action-button" onAction="#handleOfferRide" />
                <Button text="Cerca Passaggio" styleClass="action-button" onAction="#handleSearchRide" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
