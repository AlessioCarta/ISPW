<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.uniride.boundary.OfferRideBoundary" stylesheets="@style.css">
    <top>
        <HBox spacing="20" styleClass="dashboard-header">
            <Button text="Indietro" onAction="#handleBack" />
            <Label text="Offri un Passaggio" styleClass="dashboard-title" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="15.0" maxWidth="300">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <GridPane hgap="10" vgap="15">
                <Label text="Partenza:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                <TextField fx:id="departureField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Destinazione:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
                <TextField fx:id="destinationField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-label"/>
                <TextField fx:id="dateField" promptText="gg/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Posti Totali:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-label"/>
                <TextField fx:id="seatsField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Costo Base (€):" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="form-label"/>
                <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>
            <Button text="Conferma" styleClass="action-button" onAction="#handleSubmit" />
            <Label fx:id="messageLabel" textFill="GREEN" />
        </VBox>
    </center>
</BorderPane>
