<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ispw.uniride.boundary.RegisterBoundary" stylesheets="@style.css" styleClass="app-background">

    <VBox alignment="CENTER" spacing="24.0" styleClass="card" maxWidth="360" maxHeight="-Infinity">

        <VBox alignment="CENTER" spacing="6.0">
            <Label text="✨ Crea il tuo account" styleClass="app-title" />
            <Label text="Unisciti alla community di UniRide" styleClass="app-subtitle" wrapText="true" textAlignment="CENTER" />
        </VBox>

        <VBox spacing="12.0">
            <TextField fx:id="fullNameField" promptText="Nome e Cognome" />
            <TextField fx:id="usernameField" promptText="Username" />
            <PasswordField fx:id="passwordField" promptText="Password" />
            <Button text="Conferma Registrazione" onAction="#handleRegisterSubmit" maxWidth="Infinity" styleClass="action-button" />
            <Button text="Indietro" onAction="#handleBack" maxWidth="Infinity" styleClass="secondary-button" />
            <Label fx:id="messageLabel" styleClass="message-label" textFill="RED" wrapText="true" alignment="CENTER" maxWidth="Infinity" />
        </VBox>
    </VBox>
</StackPane>
